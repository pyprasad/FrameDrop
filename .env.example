# Database
DATABASE_URL=postgresql://framedrop:framedrop_dev_password@localhost:5432/framedrop

# Redis
REDIS_URL=redis://localhost:6379

# S3 Storage (MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=framedrop
S3_REGION=us-east-1
S3_USE_SSL=false

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# SSO Configuration
# SAML
SAML_ENTRY_POINT=https://your-idp.com/sso/saml
SAML_ISSUER=framedrop
SAML_CALLBACK_URL=http://localhost:4000/auth/saml/callback
SAML_CERT=your_idp_certificate

# OAuth 2.0 / OIDC
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_CALLBACK_URL=http://localhost:4000/auth/oauth/callback
OAUTH_AUTHORIZATION_URL=https://your-idp.com/oauth/authorize
OAUTH_TOKEN_URL=https://your-idp.com/oauth/token
OAUTH_USER_INFO_URL=https://your-idp.com/oauth/userinfo

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@framedrop.com

# Application Settings
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
MAX_FILE_SIZE=10737418240
# Max file size in bytes (10GB default)
DEFAULT_TRANSFER_EXPIRY_DAYS=7
FREE_TIER_SIZE_LIMIT=2147483648
# 2GB for free tier

# Enterprise Features
ENABLE_SSO=true
ENABLE_ADMIN_DASHBOARD=true
ENABLE_ANALYTICS=true
